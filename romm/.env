# --------------------------------------------------
# RomM Docker Environment Example (.env)
# Copy this file to `.env` and fill in real values before use.
# NEVER commit your filled .env with secrets to a public repo.
# --------------------------------------------------

# ------- MariaDB Database Settings -------

# The hostname of your MariaDB container (should match your docker-compose service name)
DB_HOST=romm-db

# The name of the database RomM will use
DB_NAME=romm

# The username for the RomM database (change to your preferred user)
DB_USER=romm-user

# The password for the RomM database user (choose a strong password)
DB_PASSWD=example-secure-password

# MariaDB root password (pick something unique and secure)
MARIADB_ROOT_PASSWORD=example-root-password

# ------- RomM Application Settings -------

# Secret key for session authentication (generate with: openssl rand -hex 32)
#ROMM_AUTH_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Enable Hasheous API (true/false)
#HASHEOUS_API_ENABLED=true

# ------- Metadata Provider Credentials (Optional, but recommended) -------

# ScreenScraper (Get an account at https://www.screenscraper.fr/)
#SCREENSCRAPER_USER=your-screenscraper-username
#SCREENSCRAPER_PASSWORD=your-screenscraper-password

# RetroAchievements (API key from your account page)
#RETROACHIEVEMENTS_API_KEY=your-retroachievements-api-key

# SteamGridDB (Get an API key at https://www.steamgriddb.com/)
#STEAMGRIDDB_API_KEY=your-steamgriddb-api-key

# ------- Example End -------
# After copying this file and setting real values, keep .env out of version control (add to .gitignore).
